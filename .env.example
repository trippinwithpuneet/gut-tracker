# Copy to .env.local and fill in.
#
# Both values are safe to expose in a browser. The anon (publishable) key only
# grants what row-level security allows, which in this app is "your own rows plus
# the curated food and symptom libraries". The service-role key must never be
# added here — it belongs only in Supabase Edge Function secrets, where the
# reminder job reads it.
#
# Leaving these blank is a supported setup: the app runs in local-only mode,
# storing everything in the browser, and hides sign-in entirely. `git clone &&
# npm install && npm run dev` works with no Supabase project at all.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Enables daily reminders. Generate a pair with:
#
#   npx web-push generate-vapid-keys
#
# The PUBLIC half goes here and ships to the browser, which is what it is for.
# The PRIVATE half goes to Supabase as an Edge Function secret and nowhere else.
# Leaving this blank simply hides the reminder switch.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
